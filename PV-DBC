<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>COMPANY NAME - Digital Business Card</title>
<style>
  :root{
    --primary:#1a2b4c;
    --accent:#c9a15a;
    --bg:#f5f5f7;
    --card-bg:#ffffff;
    --text:#222;
    --muted:#666;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{
    font-family: 'Segoe UI', Arial, sans-serif;
    background:var(--bg);
    display:flex;
    justify-content:center;
    padding:30px 15px;
  }
  .card{
    background:var(--card-bg);
    max-width:420px;
    width:100%;
    border-radius:18px;
    box-shadow:0 10px 30px rgba(0,0,0,0.12);
    overflow:hidden;
  }
  .cover{
    /* company photo goes here */
    background: url('COMPANY_PHOTO_URL_OR_FILENAME.jpg') center/cover no-repeat, var(--primary);
    height:150px;
    position:relative;
  }
  .logo-wrap{
    position:absolute;
    bottom:-45px;
    left:50%;
    transform:translateX(-50%);
    width:90px;height:90px;
    border-radius:50%;
    border:4px solid var(--card-bg);
    overflow:hidden;
    background:#fff;
    box-shadow:0 2px 8px rgba(0,0,0,0.2);
  }
  .logo-wrap img{width:100%;height:100%;object-fit:cover;}
  .info{
    text-align:center;
    padding:60px 24px 20px;
  }
  .info h1{
    font-size:1.4rem;
    color:var(--primary);
  }
  .info p.tagline{
    color:var(--muted);
    font-size:0.9rem;
    margin-top:4px;
  }

  .action-buttons{
    display:flex;
    gap:10px;
    padding:0 24px 20px;
  }
  .action-buttons a{
    flex:1;
    text-align:center;
    padding:12px 0;
    border-radius:10px;
    text-decoration:none;
    font-weight:600;
    font-size:0.9rem;
  }
  .call-btn{background:var(--primary);color:#fff;}
  .email-btn{background:var(--accent);color:#fff;}

  .details{
    padding:0 24px 10px;
    border-top:1px solid #eee;
  }
  .details .row{
    display:flex;
    align-items:center;
    gap:12px;
    padding:12px 0;
    border-bottom:1px solid #f0f0f0;
    font-size:0.92rem;
    color:var(--text);
    text-decoration:none;
  }
  .details .row:last-child{border-bottom:none;}
  .details .icon{
    width:20px;text-align:center;color:var(--accent);font-size:1.1rem;
  }

  .bosses{
    padding:10px 24px 20px;
  }
  .bosses h3{
    font-size:0.95rem;
    color:var(--primary);
    margin-bottom:12px;
    text-transform:uppercase;
    letter-spacing:0.5px;
  }
  .boss{
    display:flex;
    align-items:center;
    gap:12px;
    padding:10px 0;
  }
  .boss img{
    width:55px;height:55px;border-radius:50%;object-fit:cover;
    border:2px solid var(--accent);
  }
  .boss .name{font-weight:600;font-size:0.92rem;}
  .boss .title{font-size:0.8rem;color:var(--muted);}
  .boss-contact{
    margin-left:auto;
    display:flex;
    gap:8px;
  }
  .boss-contact a{
    width:34px;height:34px;
    border-radius:50%;
    background:var(--bg);
    display:flex;align-items:center;justify-content:center;
    text-decoration:none;
    color:var(--primary);
    font-size:0.9rem;
  }

  .socials{
    display:flex;
    justify-content:center;
    gap:14px;
    padding:15px 24px 5px;
  }
  .socials a{
    width:42px;height:42px;
    border-radius:50%;
    background:var(--primary);
    color:#fff;
    display:flex;align-items:center;justify-content:center;
    text-decoration:none;
    font-size:1.1rem;
  }

  .qr-section{
    text-align:center;
    padding:20px 24px 30px;
    border-top:1px solid #eee;
    margin-top:10px;
  }
  .qr-section p{font-size:0.8rem;color:var(--muted);margin-top:8px;}
  .qr-section img{width:130px;height:130px;}
</style>
</head>
<body>

<div class="card">

  <!-- ===== COVER / COMPANY PHOTO ===== -->
  <div class="cover">
    <div class="logo-wrap">
      <img src="COMPANY_LOGO_URL_OR_FILENAME.jpg" alt="Company Logo">
    </div>
  </div>

  <!-- ===== COMPANY NAME ===== -->
  <div class="info">
    <h1>YOUR COMPANY NAME</h1>
    <p class="tagline">Your tagline or slogan here</p>
  </div>

  <!-- ===== QUICK ACTIONS ===== -->
  <div class="action-buttons">
    <a class="call-btn" href="tel:+10000000000">📞 Call Us</a>
    <a class="email-btn" href="mailto:info@yourcompany.com">✉️ Email Us</a>
  </div>

  <!-- ===== COMPANY DETAILS ===== -->
  <div class="details">
    <a class="row" href="tel:+10000000000">
      <span class="icon">📞</span> +1 (000) 000-0000
    </a>
    <a class="row" href="mailto:info@yourcompany.com">
      <span class="icon">✉️</span> info@yourcompany.com
    </a>
    <a class="row" href="https://www.yourcompany.com" target="_blank">
      <span class="icon">🌐</span> www.yourcompany.com
    </a>
    <a class="row" href="https://maps.google.com/?q=YOUR+COMPANY+ADDRESS" target="_blank">
      <span class="icon">📍</span> Your Company Address, City, Country
    </a>
  </div>

  <!-- ===== LEADERSHIP / BOSSES ===== -->
  <div class="bosses">
    <h3>Leadership</h3>

    <div class="boss">
      <img src="BOSS1_PHOTO_URL_OR_FILENAME.jpg" alt="Boss 1">
      <div>
        <div class="name">Boss One Name</div>
        <div class="title">CEO / Founder</div>
      </div>
      <div class="boss-contact">
        <a href="tel:+10000000001" title="Call">📞</a>
        <a href="mailto:boss1@yourcompany.com" title="Email">✉️</a>
      </div>
    </div>

    <div class="boss">
      <img src="BOSS2_PHOTO_URL_OR_FILENAME.jpg" alt="Boss 2">
      <div>
        <div class="name">Boss Two Name</div>
        <div class="title">Managing Director</div>
      </div>
      <div class="boss-contact">
        <a href="tel:+10000000002" title="Call">📞</a>
        <a href="mailto:boss2@yourcompany.com" title="Email">✉️</a>
      </div>
    </div>

    <!-- Duplicate the .boss block above to add more leadership members -->
  </div>

  <!-- ===== SOCIAL MEDIA LINKS ===== -->
  <div class="socials">
    <a href="https://facebook.com/yourpage" target="_blank" title="Facebook">f</a>
    <a href="https://instagram.com/yourpage" target="_blank" title="Instagram">IG</a>
    <a href="https://linkedin.com/company/yourpage" target="_blank" title="LinkedIn">in</a>
    <a href="https://wa.me/10000000000" target="_blank" title="WhatsApp">WA</a>
    <!-- Add or remove <a> tags for other platforms (Twitter/X, YouTube, TikTok, etc.) -->
  </div>

  <!-- ===== QR CODE (points to this page once it's published online) ===== -->
  <div class="qr-section">
    <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://www.yourcompany.com/business-card"
         alt="Scan QR Code">
    <p>Scan to save this card / visit our website</p>
  </div>

</div>

</body>
</html>
